# Google Gemini API Key (Required for AI analysis of repository data)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Optional, defaults to gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# GitHub Personal Access Token (Optional, increases GitHub REST API rate limit from 60 to 5000 requests/hour)
# Create a fine-grained or classic token (read-only / public repos) at: https://github.com/settings/tokens
GITHUB_TOKEN=
